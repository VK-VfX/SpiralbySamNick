<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NeverSpiral" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Launch theme: the system splash screen (the glyph on black) that hands over to the app. -->
    <style name="Theme.NeverSpiral.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NeverSpiral</item>
    </style>
</resources>
