<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes the app-private Download subfolder of getExternalFilesDir() (where UpdateChecker
     saves the OTA APK) through a content:// URI, since the system package installer can't be
     granted read access to a plain file:// path in our private storage. Environment.DIRECTORY_DOWNLOADS
     resolves to "Download" (singular), matching the path below. -->
<paths>
    <external-files-path name="ota-downloads" path="Download/" />
</paths>
