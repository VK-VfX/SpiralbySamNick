<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes app-private storage through content:// URIs, since other apps (a share-sheet target,
     the system package installer) can't be granted read access to a plain file:// path in our
     private storage. -->
<paths>
    <!-- Where FrameCapture writes a captured visualizer frame before handing it to the share
         sheet: cache rather than files/, since these are disposable, regeneratable on demand. -->
    <cache-path name="shared-frames" path="shared_frames/" />
</paths>
