<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes app-private storage through content:// URIs, since other apps (the share sheet, a
     gallery-preview intent) can't be granted read access to a plain file:// path in our private
     storage. -->
<paths>
    <!-- Where CaptureStore stages a just-captured photo/video/RAW file before (and briefly after)
         it's copied into the shared MediaStore collection: cache rather than files/, since once
         the MediaStore copy exists this one is disposable. -->
    <cache-path name="captures" path="captures/" />
    <!-- Downloaded update APKs, handed to the package installer. -->
    <cache-path name="updates" path="updates/" />
</paths>
