<?xml version="1.0" encoding="utf-8"?>
<!-- A static, tap-to-open widget -- there's no way to render the live Compose Canvas visualizer
     into a RemoteViews layout, so this is branding plus a fast-path launcher rather than a live
     preview. Colors are hardcoded to match VisualizerTheme since widget layouts can't reference
     the app's Compose theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FF15161B"
    android:padding="12dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_tile_bars"
        android:tint="#FF5AC8E0" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="@string/app_name"
        android:textColor="#FFE7E9EE"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:maxLines="2" />
</LinearLayout>
