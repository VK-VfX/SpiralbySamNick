    <path android:fillColor="#FFFFFFFF" android:pathData="M8.5,8 h3 v12 h-3 z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M14,11 h3 v9 h-3 z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M19.5,4 h3 v16 h-3 z" />
</vector>
