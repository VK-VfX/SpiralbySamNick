<?xml version="1.0" encoding="utf-8"?>
<!-- A soft center-to-edge radial gradient rather than flat white -- the subtle falloff is what
     reads as "materialistic" (a lit, slightly domed surface) instead of a flat paper cutout,
     while staying close enough to white/black that the spiral foreground still reads crisply on
     every launcher's icon mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:startColor="#FFFFFF"
                android:endColor="#E4E4E7" />
        </aapt:attr>
    </path>
</vector>
